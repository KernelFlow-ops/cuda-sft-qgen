# =============================================================================
# cuda-sft-qgen 超参数
# 布尔值：1/true/yes/on 为开，0/false/no/off 为关
# =============================================================================

# --- API 与模型 ---
# 每个角色的 PROVIDER 选择请求格式：nvidia 或 openai；BASE_URL 填对应 API 地址。
# Writer 必填；每组也支持 *_API_KEY_2、*_API_KEY_3 或逗号分隔的 *_API_KEYS。
WRITER_PROVIDER=nvidia
WRITER_API_KEY=
WRITER_API_KEY_2=
WRITER_API_KEY_3=
WRITER_BASE_URL=https://integrate.api.nvidia.com/v1
WRITER_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# 其他角色留空时继承 Writer 对应字段。更换 PROVIDER 或 BASE_URL 时，
# 必须同时填写该角色的 BASE_URL 和 API_KEY。
EVOLVER_PROVIDER=
EVOLVER_API_KEY=
EVOLVER_BASE_URL=
EVOLVER_MODEL=

REVIEW_PROVIDER=openai
REVIEW_API_KEY=
REVIEW_BASE_URL=https://www.poke2api.com
REVIEW_MODEL=gpt-6-sol

SALVAGE_PROVIDER=
SALVAGE_API_KEY=
SALVAGE_BASE_URL=
SALVAGE_MODEL=

# Architect 排队的知识/分类任务及相关 CLI 使用本组。
KNOWLEDGE_PROVIDER=
KNOWLEDGE_API_KEY=
KNOWLEDGE_BASE_URL=
KNOWLEDGE_MODEL=

# 出题/审题思考等级：OpenAI 发送 reasoning_effort；NVIDIA 使用 chat_template_kwargs
# 要 1-2 题/分钟必须 none。low 也会把 max_tokens 预算吃进 reasoning，单次 60-150s。
THINKING_LEVEL=none
# 单次 chat 补全上限（含 thinking tokens）；覆盖 configs/default.yaml generation.max_tokens
# thinking=none 时 2048-4096 足够；开 thinking 时 2048 会 length 截断 JSON
MAX_TOKENS=4096
# 出题可单独覆盖思考等级；空则继承 THINKING_LEVEL
# WRITER_THINKING_LEVEL=none
# EVOLVER_THINKING_LEVEL=medium

# embedding 后端独立配置：nvidia API、huggingface 本地模型或 fake 测试模式
EMBEDDING_PROVIDER=nvidia
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# 质量档（需 GPU）：pip install -e ".[hf]"
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# --- 并发 ---
# 每个 API key 同时进行的聊天请求数。总 LLM 并发 = key 数量 × 本值
# 2/key 容易在开批时把网关打成 overloaded；API 不稳时改 1
LLM_PER_KEY_CONCURRENCY=4
# 同时处理 N 道题：需与 API key 可承受的聊天并发一致
WRITER_CONCURRENCY=4
WRITER_SUBMIT_STAGGER_SEC=0
MIN_GENERATE_BATCH=4
CHAIR_MAX_WORKERS=2
CHAIR_TRIGGER_COUNT=1
REPAIR_CONCURRENCY=2
REVIEW_REPAIR_ENABLED=1
REVIEW_REPAIR_MAX_ATTEMPTS=1
# 每个 API key 同时进行的 embedding 请求数。总 embed 并发 = key 数量 × 本值
EMBED_PER_KEY_CONCURRENCY=2
# 审题时把待审题目切成若干份并行 embed；实际还会按 embed 并发再拆
EMBED_CHUNK_SIZE=8

# --- 题干长度（Python len，含代码围栏）---
# 最短字符数；过短直接 sieve_too_short，不进 429 队列
QUESTION_MIN_CHARS=40
# 最长字符数；超长先 Salvage 压缩，仍超长才 sieve_too_long
QUESTION_MAX_CHARS=2500

# --- 产出规模 ---
# 凑满这么多 pending 才启动审题（尾批不足也会审）
REVIEW_BATCH_SIZE=20
# 目标收录题量（accepted 达到后停止）
TARGET_QUESTION_COUNT=1000
# 规划/出题循环上限，防止死循环
MAX_ITERATIONS=200

# --- 审题查重（默认宽松：只拦重复，不因配额删题）---
# 语义近重复：cosine ≥ 此值直接拒
SEMANTIC_DUP_THRESHOLD=0.93
# 语义灰区下界：落在 [GRAY, DUP) 且模板也像才拒；否则放过并记 warning
SEMANTIC_GRAY_THRESHOLD=0.88
# 模板重复：骨架 token Jaccard ≥ 此值视为同一训练模板，拒绝
TEMPLATE_JACCARD_THRESHOLD=0.88
# 模板灰区 Jaccard 下界（配合 SimHash 灰区）
TEMPLATE_GRAY_JACCARD=0.75
# 模板重复：SimHash 汉明距离 ≤ 此值视为同一模板，拒绝
SIMHASH_HAMMING_THRESHOLD=3
# 模板灰区汉明距离上界
SIMHASH_GRAY_HAMMING=8

# 每 K 个审题批次才打一次 Review Chair LLM 写转向 brief；1=每批都写
REVIEW_LLM_EVERY_K_BATCHES=1
# 出题后是否再用 LLM 做 meaningful/garbage 二分类（规则筛已经会拦空泛题）
SIEVE_USE_LLM=0
# 出题后、审题前：高确信度自洽检查。失败则按缺陷重写一次，仍坏则不进 Chair
WRITER_CONSISTENCY_GATE=1
# 可选模型预审；默认只跑本地高确信度规则，由后续独立 Chair 完整审核
WRITER_GATE_LLM=0
WRITER_GATE_REWRITE=1
# OpenAI 思考模型做 Writer Gate 时建议 2048，避免 512 token 只够思考不够最终 JSON
# WRITER_GATE_MAX_TOKENS=2048
# 是否把模型 reasoning_content 打到日志（体积大）
LOG_REASONING=0
# 仅内部非生题测试使用；generate/resume/benchmark 强制真实 API
FAKE_LLM=0

# --- Salvage：坏 JSON 先救题，不要直接丢掉 ---
# 是否启用 Salvage 节点（本地解析 + 可选 LLM 修格式）
SALVAGE_ENABLED=1
# 本地解析仍失败时，是否再打一次 LLM 只修 JSON、不改考点
SALVAGE_USE_LLM=0
# 0=坏 JSON 交给 salvage 节点，不占用 writer 线程再打一枪
SALVAGE_INLINE=0
# 每条坏 JSON 最多再请求 Salvage LLM 的次数
SALVAGE_LLM_ATTEMPTS=1
# Salvage 调用的思考等级：建议 none，省 token
SALVAGE_THINKING_LEVEL=none
# Salvage 输出 token 上限（修 JSON 不需要跟 writer 一样大）
SALVAGE_MAX_TOKENS=1024
# JSON 被截断但题干已经够长时：用任务单 claim 补 tests_claim 并收下
JSON_KEEP_TRUNCATED=1

# --- 429 排队：限流不拒绝，等本批正常请求之后再打 ---
# 是否在本批成功出题后自动捞 retry 队列
RETRY_DRAIN_ENABLED=1
# 同一任务单跨批次最多重试几次，超过才写入 rejected（reason=retry_exhausted）
RETRY_MAX_ATTEMPTS=5
# 首次 429 入队后等待秒数，之后按 2^n 递增
RETRY_BASE_COOLDOWN_SEC=15
# 排队等待上限（秒）
RETRY_MAX_COOLDOWN_SEC=120
# 每次 drain 最多捞几条；0=自动，等于当前 writer 并发
RETRY_DRAIN_BATCH=0
# 单次 LLM 调用内，每个 key 遇到 429 再试几次（3 个 key 时约 3×本值）
LLM_RATE_LIMIT_RETRIES_PER_CALL=2

# 简单题 solver 思考等级
SOLVER_THINKING_LEVEL=low
# 难题 solver 思考等级
SOLVER_THINKING_LEVEL_HARD=medium
# 联合约束规划开关，0 可回退旧路径
PLANNER_JOINT_SAMPLING=1
# 单次真实评测的模型请求上限
QGEN_LLM_MAX_CALLS=600
# 真实评测产物目录
QGEN_EVAL_OUT=
